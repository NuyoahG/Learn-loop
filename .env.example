# 参考配置。请在各服务的启动终端设置环境变量。
# MySQL 应用账号的密码请单独输入 LEARNLOOP_DB_PASSWORD。
LEARNLOOP_DB_URL=jdbc:mysql://127.0.0.1:3306/learnloop?sslMode=REQUIRED&characterEncoding=UTF-8
LEARNLOOP_DB_USER=learnloop_app

# 可选。设置时使用你自己的绝对路径。
# LEARNLOOP_MATERIAL_STORAGE_ROOT=

# Java 服务
LEARNLOOP_LEARNING_ENABLED=true
LEARNLOOP_GENERATION_ENABLED=true
LEARNLOOP_MODEL_SETTINGS_ENABLED=true

# Python 服务
LEARNLOOP_BKT_ENABLED=true
# Python 也读取 LEARNLOOP_GENERATION_ENABLED。

# Next.js 构建前设置
LEARNLOOP_BACKEND_URL=http://127.0.0.1:8080
